# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# NOTE: none of these are VITE_-prefixed, deliberately. Vite only exposes
# VITE_-prefixed vars to client code, so prefixing any of these would inline
# the secret into the production bundle where anyone can read it. They are read
# by the API server (server/) via process.env and never reach the browser.

# Google Gemini API key, used by POST /api/ai/generate as the shared fallback
# when a player hasn't pasted their own key in Settings.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Port for the local API server. Optional; defaults to 3000, which is what
# vite.config.ts proxies /api to.
# PORT=3000

# --- Accounts (Clerk) -------------------------------------------------------
# Optional. With these unset the app runs fully as a local-only build: no
# account UI, every request treated as signed out, and the shared Gemini key
# above stays usable locally. Provisioned automatically by the Vercel
# Marketplace integration on the deployment.

# Server-side Clerk API key. Never VITE_-prefixed.
CLERK_SECRET_KEY=

# Publishable key, safe to expose — it identifies the Clerk instance and is
# designed to live in client code, which is why VITE_ is correct here.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Cloud sync + feedback (Neon Postgres) ----------------------------------
# Optional. Without it, sync and feedback return 503 and the rest of the app is
# unaffected. Provisioned by `vercel integration add neon`.
DATABASE_URL=

# --- Feedback -> GitHub issues ----------------------------------------------
# Fine-grained PAT scoped to the issues repo only, with Issues: read & write and
# nothing else. Without it, feedback is still stored; only the issue is skipped.
GITHUB_TOKEN=
# Override the target repo. Defaults to VidurShah/dnd-char-creator.
# GITHUB_REPO=owner/name
