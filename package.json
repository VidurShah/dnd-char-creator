{
  "name": "dnd-char-creator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"vite\" \"pnpm dev:api\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "concurrently -n vite,api -c cyan,magenta \"vite preview\" \"pnpm dev:api\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "validate:data": "tsx scripts/validateData.ts --strict-descriptions",
    "validate:data:loose": "tsx scripts/validateData.ts",
    "check:responsive": "tsx scripts/checkResponsive.ts",
    "seed:srd51": "tsx scripts/seed/seed-srd51.ts",
    "seed:srd51:rules": "tsx scripts/seed/seed-srd51-rules.ts",
    "seed:srd52": "tsx scripts/seed/seed-srd52.ts",
    "extract:run": "tsx --env-file=.env scripts/extract/extract.ts",
    "extract:review": "tsx scripts/extract/review.ts",
    "extract:compile": "tsx scripts/extract/compile.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env server/dev.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/react": "^6.14.8",
    "@google/genai": "^2.12.0",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
